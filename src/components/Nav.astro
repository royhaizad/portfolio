---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { url, img } from '../lib/data';
// Anchor mapping is the suggested one from docs/02-site-map.md section 3 (owner to confirm).
const links = [
  { label: 'Work', href: url('/#work') },
  { label: 'Projects', href: url('/#projects') },
  { label: 'About', href: url('/#about') },
  { label: 'Contact', href: url('/#contact') },
];
interface Props { hideAvatar?: boolean }
// Home only: the avatar waits until the hero portrait has scrolled away (motion.ts, section 9).
const { hideAvatar = false } = Astro.props;
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-canvas/90 backdrop-blur">
  <div class="mx-auto flex h-[72px] max-w-[1440px] items-center justify-between px-5 md:h-[88px] md:px-20">
    <a href={url('/')} class="flex min-h-[44px] items-center whitespace-nowrap font-display text-[22px] font-semibold leading-[1.2] tracking-[-0.01em] md:text-[28px]">
      <span data-nav-avatar-wrap data-avatar-hidden={hideAvatar ? "" : undefined} class="flex shrink-0 items-center pr-3">
        <Image src={img('profile/portrait.png')} alt="" width={96} height={96} loading="eager" class="size-10 shrink-0 rounded-full object-cover md:size-12" />
      </span>
      Rohaizad Johari
    </a>

    <nav aria-label="Main" class="hidden items-center gap-10 xl:flex">
      {links.map((l) => (
        <a href={l.href} data-nav={l.href.split("#")[1]} class="text-[18px] font-semibold tracking-[-0.0025em] transition-colors hover:text-accent">{l.label}</a>
      ))}
    </nav>

    <div class="hidden items-center gap-6 xl:flex">
      <p class="flex items-center gap-2 text-[15px] leading-[1.55]">
        <span class="relative flex size-2.5" aria-hidden="true"><span class="absolute inline-flex size-full rounded-full bg-live opacity-60 motion-safe:animate-[ping_2s_cubic-bezier(0,0,0.2,1)_infinite]"></span><span class="relative inline-flex size-2.5 rounded-full bg-live"></span></span>
        Open to new roles
      </p>
      <Button label="Let's Talk" icon="message-circle" variant="secondary" href={url('/#contact')} class="!py-3" />
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="grid size-11 place-items-center rounded-full border border-line xl:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <Icon name="menu" size={22} />
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-canvas px-5 pb-8 pt-4 xl:!hidden">
    <nav aria-label="Mobile" class="flex flex-col">
      {links.map((l) => (
        <a href={l.href} data-nav={l.href.split("#")[1]} class="border-b border-line py-4 font-display text-[28px] font-semibold tracking-[-0.01em]">{l.label}</a>
      ))}
    </nav>
    <p class="mt-6 flex items-center gap-2 text-[14px]">
      <span class="relative flex size-2.5" aria-hidden="true"><span class="absolute inline-flex size-full rounded-full bg-live opacity-60 motion-safe:animate-[ping_2s_cubic-bezier(0,0,0.2,1)_infinite]"></span><span class="relative inline-flex size-2.5 rounded-full bg-live"></span></span>
      Open to new roles
    </p>
    <Button label="Let's Talk" icon="message-circle" variant="secondary" href={url('/#contact')} class="mt-4 w-full" />
  </div>
</header>

<script>
  import gsap from 'gsap';

  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');
  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let isOpen = false;

  const items = () => (menu ? Array.from(menu.querySelectorAll('nav a, p, a[class*="w-full"]')) : []);

  const setOpen = (open: boolean) => {
    if (!toggle || !menu || open === isOpen) return;
    isOpen = open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    gsap.killTweensOf([menu, ...items()]);
    if (open) {
      menu.classList.remove('hidden');
      if (reduce()) return;
      gsap.fromTo(menu, { yPercent: -4, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.35, ease: 'power3.out' });
      gsap.fromTo(items(), { y: -12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: 'power3.out', stagger: 0.05, delay: 0.05, clearProps: 'transform,opacity' });
    } else {
      const done = () => {
        menu.classList.add('hidden');
        gsap.set(menu, { clearProps: 'transform,opacity' });
      };
      if (reduce()) return done();
      // Continue from wherever a swipe left the panel.
      gsap.to(menu, { y: Math.min(Number(gsap.getProperty(menu, 'y')) || 0, -menu.offsetHeight * 0.5), opacity: 0, duration: 0.28, ease: 'power2.in', onComplete: done });
    }
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

  // Swipe up anywhere while the menu is open to close it. The panel follows the finger, then either
  // flies away (distance or flick speed) or springs back.
  if (menu) {
    let startY = 0;
    let startX = 0;
    let startT = 0;
    let dy = 0;
    let dragging = false;
    let locked = false; // gesture decided to be horizontal or a scroll, ignore it

    document.addEventListener('touchstart', (e) => {
      if (!isOpen || e.touches.length !== 1) return;
      startY = e.touches[0].clientY;
      startX = e.touches[0].clientX;
      startT = performance.now();
      dy = 0;
      dragging = false;
      locked = false;
      gsap.killTweensOf(menu);
    }, { passive: true });

    document.addEventListener('touchmove', (e) => {
      if (!isOpen || locked) return;
      const y = e.touches[0].clientY - startY;
      const x = e.touches[0].clientX - startX;
      if (!dragging) {
        if (Math.abs(x) > Math.abs(y) || y > 0) { if (Math.abs(x) > 8 || y > 8) locked = true; return; }
        if (Math.abs(y) < 8) return;
        dragging = true;
      }
      e.preventDefault();
      dy = Math.min(0, y);
      gsap.set(menu, { y: dy, opacity: 1 + dy / (menu.offsetHeight * 1.2) });
    }, { passive: false });

    const end = () => {
      if (!dragging) return;
      dragging = false;
      const speed = Math.abs(dy) / Math.max(1, performance.now() - startT); // px per ms
      if (Math.abs(dy) > 70 || speed > 0.5) {
        setOpen(false);
      } else {
        gsap.to(menu, { y: 0, opacity: 1, duration: 0.45, ease: 'elastic.out(1, 0.6)', clearProps: 'transform,opacity' });
      }
    };
    document.addEventListener('touchend', end);
    document.addEventListener('touchcancel', end);
  }
</script>
