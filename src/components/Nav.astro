---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { url, img } from '../lib/data';
// Anchor mapping is the suggested one from docs/02-site-map.md section 3 (owner to confirm).
const links = [
  { label: 'Work', href: url('/#work') },
  { label: 'Projects', href: url('/#projects') },
  { label: 'About', href: url('/#about') },
  { label: 'Contact', href: url('/#contact') },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-canvas/90 backdrop-blur">
  <div class="mx-auto flex h-[72px] max-w-[1440px] items-center justify-between px-5 md:h-[88px] md:px-20">
    <a href={url('/')} class="flex items-center gap-3 whitespace-nowrap font-display text-[22px] font-semibold leading-[1.2] tracking-[-0.01em] md:text-[28px]">
      <Image src={img('profile/portrait.png')} alt="" width={96} height={96} loading="eager" class="size-10 shrink-0 rounded-full object-cover md:size-12" />
      Rohaizad Johari
    </a>

    <nav aria-label="Main" class="hidden items-center gap-10 xl:flex">
      {links.map((l) => (
        <a href={l.href} data-nav={l.href.split("#")[1]} class="text-[18px] font-semibold tracking-[-0.0025em] transition-colors hover:text-accent">{l.label}</a>
      ))}
    </nav>

    <div class="hidden items-center gap-6 xl:flex">
      <p class="flex items-center gap-2 text-[15px] leading-[1.55]">
        <span class="relative flex size-2.5" aria-hidden="true"><span class="absolute inline-flex size-full rounded-full bg-live opacity-60 motion-safe:animate-[ping_2s_cubic-bezier(0,0,0.2,1)_infinite]"></span><span class="relative inline-flex size-2.5 rounded-full bg-live"></span></span>
        Open to new roles
      </p>
      <Button label="Let's Talk" icon="message-circle" variant="secondary" href={url('/#contact')} class="!py-3" />
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="grid size-11 place-items-center rounded-full border border-line xl:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <Icon name="menu" size={22} />
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-canvas px-5 pb-8 pt-4 xl:!hidden">
    <nav aria-label="Mobile" class="flex flex-col">
      {links.map((l) => (
        <a href={l.href} data-nav={l.href.split("#")[1]} class="border-b border-line py-4 font-display text-[28px] font-semibold tracking-[-0.01em]">{l.label}</a>
      ))}
    </nav>
    <p class="mt-6 flex items-center gap-2 text-[14px]">
      <span class="relative flex size-2.5" aria-hidden="true"><span class="absolute inline-flex size-full rounded-full bg-live opacity-60 motion-safe:animate-[ping_2s_cubic-bezier(0,0,0.2,1)_infinite]"></span><span class="relative inline-flex size-2.5 rounded-full bg-live"></span></span>
      Open to new roles
    </p>
    <Button label="Let's Talk" icon="message-circle" variant="secondary" href={url('/#contact')} class="mt-4 w-full" />
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');
  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>

