---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Tag from './Tag.astro';
import Lines from './Lines.astro';
import { img, url, type TagData } from '../lib/data';

interface Props {
  slug: string;
  cardImage: string;
  number: string;
  showNumber?: boolean;
  title: string;
  meta: string;
  description: string;
  tags: TagData[];
  size?: 'featured' | 'standard';
  /** Animated light over the coloured background (home cards only; needs public/glow/mask-NN.png). */
  glow?: boolean;
}
const { slug, cardImage, number, title, meta, description, tags, size = 'featured', showNumber = true, glow = false } = Astro.props;
const featured = size === 'featured';
// Accent light sampled from each project's own design (the colours inside its mockup):
// 01 Ecological Network: lime-yellow of the rainforest hero photo
// 02 Light Rail microsite: orange of the shophouse awnings + warm cream card
// 03 Religious Council portal: the portal's signature yellow and gold
const neon: Record<string, string[]> = {
  '01': ['214,240,70', '238,246,100', '188,226,60'],
  '02': ['222,122,50', '240,208,128', '216,96,48'],
  '03': ['255,238,90', '255,240,16', '240,208,80'],
};
const glowId = cardImage.match(/mockup-(\d+)/)?.[1] ?? '';
const [n1, n2, n3] = neon[glowId] ?? ['255,255,255', '255,244,214', '214,232,255'];
const glowMask = glow ? `/glow/${cardImage.split('/').pop()!.replace('mockup', 'mask')}` : null;
---

<a
  data-reveal
  href={url(`/work/${slug}`)}
  class="group flex flex-col overflow-hidden rounded-lg border border-line bg-surface shadow-card-rest transition-shadow duration-[400ms] hover:shadow-card-hover"
>
  <div class="relative overflow-hidden bg-surface-alt">
    <Image
      src={img(cardImage)}
      alt={`${title.replace('⏎', ' ')}: desktop and mobile screens`}
      widths={[640, 960, 1280]}
      sizes={featured ? '(min-width: 1280px) 1280px, 100vw' : '(min-width: 768px) 640px, 100vw'}
      class="aspect-[16/9] w-full object-cover transition-transform duration-[400ms] ease-out group-hover:scale-105"
    />
    {glowMask && (
      <div
        data-glow
        aria-hidden="true"
        class="glow pointer-events-none absolute inset-0 transition-transform duration-[400ms] ease-out group-hover:scale-105"
        style={`--glow-mask:url(${url(glowMask)})`}
      >
        <span class="glow-blob" style={`left:-5%;top:-15%;width:70%;aspect-ratio:1;--c:${n1}`}></span>
        <span class="glow-blob" style={`right:-10%;bottom:-25%;width:75%;aspect-ratio:1;--c:${n2}`}></span>
        <span class="glow-blob" style={`left:30%;top:20%;width:50%;aspect-ratio:1;--c:${n3}`}></span>
      </div>
    )}
    {showNumber && (
      <span class="absolute left-4 top-4 grid h-10 min-w-10 place-items-center rounded-full bg-surface px-3 text-[14px] font-semibold md:left-6 md:top-6">{number}</span>
    )}
    <span class="absolute bottom-4 right-4 grid size-14 translate-y-2 place-items-center rounded-full bg-accent text-white opacity-0 transition-all duration-[400ms] group-hover:translate-y-0 group-hover:opacity-100 md:bottom-6 md:right-6" aria-hidden="true">
      <Icon name="arrow-up-right" size={24} />
    </span>
  </div>
  <div class="flex flex-col gap-4 p-5 md:p-8">
    <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-ink-2">{meta}</p>
    <h3 class:list={['font-display font-bold leading-[1.1] tracking-[-0.02em] transition-colors duration-[400ms] group-hover:text-accent', featured ? 'text-[28px] md:text-[40px]' : 'text-[24px] md:text-[32px]']}>
      <Lines text={title} />
    </h3>
    <p class="max-w-[720px] text-[15px] leading-[1.55] text-ink-2 md:text-[18px]">{description}</p>
    <div class="flex flex-wrap gap-2">
      {tags.map((t) => <Tag type={t.type as any} label={t.label} />)}
    </div>
  </div>
</a>

<style>
  /* Light layer confined to the coloured background by an alpha mask (scripts/make-glow-masks.mjs).
     Blobs rest at these positions; motion.ts drifts them with GSAP. */
  .glow {
    overflow: hidden;
    -webkit-mask-image: var(--glow-mask);
    mask-image: var(--glow-mask);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    mix-blend-mode: screen;
  }
  .glow-blob {
    position: absolute;
    border-radius: 9999px;
    background: radial-gradient(closest-side, rgba(var(--c), 0.95), rgba(var(--c), 0.4) 50%, rgba(var(--c), 0) 100%);
    will-change: transform, opacity;
  }
</style>
