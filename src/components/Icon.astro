---
// Lucide icons (24 grid, 2px round stroke). `linkedin` was removed from lucide v1, so it is local.
const icons = import.meta.glob('../../node_modules/lucide-static/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const LINKEDIN =
  '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>';

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls = '' } = Astro.props;
const raw = name === 'linkedin' ? LINKEDIN : icons[`../../node_modules/lucide-static/icons/${name}.svg`];
if (!raw) throw new Error(`Unknown icon: ${name}`);
const svg = raw
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/\sclass="[^"]*"/, '')
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace('<svg', `<svg class="${cls}" aria-hidden="true" focusable="false"`);
---

<Fragment set:html={svg} />
