---
import { Image, getImage } from 'astro:assets';
import { img } from '../lib/data';

interface Props { image: string; alt: string; date: string; title: string; issuer: string }
const { image, alt, date, title, issuer } = Astro.props;

const meta = img(image);
// Large version for the fullscreen viewer (never upscaled past the original).
const full = await getImage({ src: meta, width: Math.min(meta.width, 1800), format: 'webp', quality: 85 });
---

<button
  type="button"
  data-cert
  data-reveal
  data-full={full.src}
  data-alt={alt}
  data-title={title}
  data-issuer={issuer}
  aria-haspopup="dialog"
  class="group flex w-full flex-col gap-6 rounded-lg border border-line bg-surface p-4 text-left transition-colors duration-300 hover:border-accent hover:bg-accent hover:text-white md:p-5"
>
  <span class="block overflow-hidden rounded-md border border-line bg-surface-alt">
    <Image
      src={meta}
      alt={alt}
      widths={[400, 600, 800]}
      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
      class="aspect-[4/3] w-full object-cover object-top transition-transform duration-[400ms] ease-out group-hover:scale-105"
    />
  </span>
  <span class="flex flex-1 flex-col gap-2 px-1 pb-1">
    <span class="text-[12px] font-semibold uppercase tracking-[0.08em] text-ink-2 transition-colors duration-300 group-hover:text-blue-100">{date}</span>
    <span class="font-display text-[22px] font-semibold leading-[1.2] tracking-[-0.01em] md:text-[26px]">{title}</span>
    <span class="mt-auto pt-2 text-[15px] text-ink-2 transition-colors duration-300 group-hover:text-blue-100 md:text-[18px]">{issuer}</span>
    <span class="sr-only">View full certificate</span>
  </span>
</button>
