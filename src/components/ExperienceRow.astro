---
import { Image } from 'astro:assets';
import { img } from '../lib/data';
interface Props { period: string; title: string; company: string; summary: string; logo: string }
const { period, title, company, summary, logo } = Astro.props;
---

<article class="grid gap-4 border-t border-line py-8 md:grid-cols-[240px_1fr] md:gap-10 md:py-12">
  <p class="text-[15px] font-semibold text-ink-2 md:text-[18px]">{period}</p>
  <div class="flex flex-col gap-4">
    <div class="flex items-center gap-4">
      <Image src={img(logo)} alt={`${company} logo`} width={96} height={96} class="size-12 shrink-0 object-contain" />
      <div>
        <h3 class="font-display text-[22px] font-semibold leading-[1.2] tracking-[-0.01em] md:text-[28px]">{title}</h3>
        <p class="text-[15px] text-ink-2 md:text-[18px]">{company}</p>
      </div>
    </div>
    <p class="max-w-[820px] text-[15px] leading-[1.6] text-ink-2 md:text-[18px]">{summary}</p>
  </div>
</article>
