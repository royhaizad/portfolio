---
import Button from './Button.astro';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { url } from '../lib/data';
---

<footer id="contact" class="scroll-mt-24 bg-inverse text-on-inverse">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-10 px-5 py-20 md:gap-16 md:px-20 md:py-40">
    <SectionHeader overline="Contact" heading="Let's work together." inverse />
    <div class="flex flex-col gap-4 md:flex-row md:flex-wrap">
      <Button label="izadjoe95@gmail.com" icon="mail" href="mailto:izadjoe95@gmail.com" />
      <Button label="LinkedIn" icon="linkedin" variant="ghost" inverse href="https://www.linkedin.com/in/royhaizad/" external />
      <Button label="Download resume" icon="download" variant="ghost" inverse href={url('/Rohaizad-Johari-Resume.pdf')} download />
    </div>
    <div class="flex flex-col gap-3 border-t border-neutral-700 pt-8 text-[14px] text-neutral-300 md:flex-row md:items-center md:justify-between md:text-[15px]">
      <p class="flex items-center gap-2"><Icon name="map-pin" size={18} />Kuala Lumpur, Malaysia</p>
      <p>© 2026 Rohaizad Johari. Designed in Figma and Claude Code.</p>
    </div>
  </div>
</footer>
