---
import Icon from './Icon.astro';
---

<button
  type="button"
  id="send-to-top"
  aria-label="Back to top"
  class="group fixed bottom-6 right-5 z-40 grid size-14 place-items-center rounded-full border border-line bg-surface text-ink shadow-float transition-colors duration-250 hover:border-ink hover:bg-ink hover:text-on-inverse md:bottom-10 md:right-10"
>
  <Icon name="arrow-up-right" size={22} class="transition-transform duration-250 group-hover:rotate-45" />
</button>

<script>
  // Smooth scroll to top, ~800ms ease-in-out. Instant when reduced motion is requested.
  const btn = document.getElementById('send-to-top');
  btn?.addEventListener('click', () => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const from = window.scrollY;
    if (reduce || from === 0) return window.scrollTo(0, 0);
    const start = performance.now();
    const dur = 800;
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
    const html = document.documentElement;
    html.style.scrollBehavior = 'auto';
    const step = (now: number) => {
      const t = Math.min((now - start) / dur, 1);
      window.scrollTo(0, from * (1 - ease(t)));
      if (t < 1) requestAnimationFrame(step);
      else html.style.scrollBehavior = '';
    };
    requestAnimationFrame(step);
  });
</script>
