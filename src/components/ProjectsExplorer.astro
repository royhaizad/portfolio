---
import Icon from './Icon.astro';
import { rows, filterOptions, countBy, url } from '../lib/data';

const typeCounts = countBy('type');
const sectorCounts = countBy('sector');
const dropdowns = [
  { key: 'type', label: 'Type', options: filterOptions.type, counts: typeCounts },
  { key: 'sector', label: 'Sector', options: filterOptions.sector, counts: sectorCounts },
];
---

<div id="explorer" class="flex flex-col gap-8 md:gap-10">
  <div class="flex flex-col gap-3 md:flex-row md:items-center md:gap-4">
    <label class="relative flex-1">
      <span class="sr-only">Search projects</span>
      <Icon name="search" size={20} class="pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 text-ink-2" />
      <input
        id="search"
        type="search"
        placeholder="Search projects"
        class="w-full rounded-full border border-line bg-surface py-4 pl-14 pr-6 text-[16px] md:text-[18px] placeholder:text-ink-2"
      />
    </label>
    <div class="grid grid-cols-2 gap-3 md:flex md:gap-4">
      {dropdowns.map((d) => (
        <div class="dd relative" data-key={d.key}>
          <button type="button" class="dd-trigger flex w-full items-center justify-between gap-3 rounded-full border border-line bg-surface px-6 py-4 text-[16px] font-semibold md:min-w-[160px] md:text-[18px]" aria-haspopup="true" aria-expanded="false">
            <span>{d.label}<span class="dd-badge ml-2 hidden rounded-full bg-accent px-2 text-[12px] text-white"></span></span>
            <Icon name="chevron-down" size={20} />
          </button>
          <div class="dd-menu absolute right-0 z-30 mt-2 hidden w-[min(320px,calc(100vw-40px))] rounded-md border border-line bg-surface p-4 shadow-float md:left-0 md:right-auto">
            <fieldset class="max-h-[320px] overflow-auto">
              <legend class="sr-only">{d.label}</legend>
              {d.options.map((o) => (
                <label class="flex min-h-[44px] cursor-pointer items-center gap-3 rounded-sm px-2 py-2 hover:bg-surface-alt">
                  <input type="checkbox" value={o} class="size-5 shrink-0 rounded-xs border-line accent-[var(--color-accent)]" />
                  <span class="flex-1 text-[15px]">{o}</span>
                  <span class="text-[13px] text-ink-2">{d.counts[o] ?? 0}</span>
                </label>
              ))}
            </fieldset>
            <div class="mt-3 flex items-center justify-between border-t border-line pt-3">
              <button type="button" class="dd-clear min-h-[44px] px-2 text-[15px] font-semibold text-ink-2 hover:text-accent">Clear all</button>
              <button type="button" class="dd-close min-h-[44px] rounded-full bg-ink px-5 py-2 text-[15px] font-semibold text-on-inverse">Show results</button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <p id="result-count" class="sr-only" aria-live="polite"></p>

  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="row-arrow-grad" gradientUnits="userSpaceOnUse" cx="4" cy="20" r="22">
        <stop offset="0" stop-color="#1F45E0" />
        <stop offset="1" stop-color="#2F5BFF" />
      </radialGradient>
    </defs>
  </svg>

  <ul id="rows" class="border-b border-line">
    {rows.map((p) => (
      <li data-reveal data-name={p.row.name.toLowerCase()} data-sector-text={p.row.sector.toLowerCase()} data-type={p.filters.type} data-sector={p.filters.sector}>
        <a
          href={url(`/work/${p.slug}`)}
          class="prow group relative isolate flex items-start gap-4 border-t border-line py-5 md:min-h-[49px] md:items-center md:gap-6 md:py-2"
        >
          <span class="flex min-w-0 flex-1 flex-col gap-1 md:contents">
            <span class="t t-num block text-[12px] font-semibold uppercase leading-[1.2] tracking-[0.08em] md:w-16 md:shrink-0 md:text-[13px]">{p.row.number}</span>
            <span class="t t-name block font-display text-[22px] font-semibold leading-[1.2] tracking-[-0.01em] md:min-w-0 md:flex-1 md:font-body md:text-[18px] md:leading-[1.6] md:tracking-[-0.0025em]">{p.row.name}</span>
            <span class="t t-sector block text-[14px] leading-[1.55] md:shrink-0 md:whitespace-nowrap md:text-[15px]">{p.row.sector}</span>
          </span>
          {/* Mobile arrow: arrow-up-right, swaps to arrow-right (light) on hover. */}
          <span class="relative size-6 shrink-0 md:hidden" aria-hidden="true">
            <span class="arr-m-default absolute inset-0 text-ink"><Icon name="arrow-up-right" size={24} /></span>
            <span class="arr-m-hover absolute inset-0 text-on-inverse"><Icon name="arrow-right" size={24} /></span>
          </span>
          {/* Desktop arrow: appears on hover; the negative margin cancels the flex gap while hidden. */}
          <span class="arr-d hidden md:block" aria-hidden="true">
            <Icon name="arrow-right" size={32} class="row-arrow" />
          </span>
        </a>
      </li>
    ))}
  </ul>

  <div id="empty" class="hidden rounded-lg border border-dashed border-line bg-surface px-6 py-16 text-center">
    <p class="font-display text-[24px] font-semibold md:text-[28px]">No projects match.</p>
    <button type="button" id="empty-clear" class="mt-4 font-semibold text-accent underline underline-offset-4">Clear search and filters</button>
  </div>
</div>

<script>
  const root = document.getElementById('explorer')!;
  const search = document.getElementById('search') as HTMLInputElement;
  const items = [...root.querySelectorAll<HTMLLIElement>('#rows > li')];
  const empty = document.getElementById('empty')!;
  const count = document.getElementById('result-count')!;
  const dds = [...root.querySelectorAll<HTMLElement>('.dd')];

  const selected = (dd: HTMLElement) =>
    [...dd.querySelectorAll<HTMLInputElement>('input:checked')].map((i) => i.value);

  function apply() {
    const q = search.value.trim().toLowerCase();
    const types = selected(root.querySelector('[data-key="type"]')!);
    const sectors = selected(root.querySelector('[data-key="sector"]')!);
    let shown = 0;
    for (const li of items) {
      const okQ = !q || li.dataset.name!.includes(q) || li.dataset.sectorText!.includes(q);
      const okT = !types.length || types.includes(li.dataset.type!);
      const okS = !sectors.length || sectors.includes(li.dataset.sector!);
      const show = okQ && okT && okS;
      li.hidden = !show;
      if (show) shown++;
    }
    empty.classList.toggle('hidden', shown > 0);
    count.textContent = `${shown} of ${items.length} projects shown`;
    // Faceted options: each option's count reflects the search and the other dropdown's selection;
    // options that would return nothing are removed (a ticked option always stays so it can be unticked).
    const matches = (li: HTMLLIElement, key: 'type' | 'sector', value: string) => {
      const okQ = !q || li.dataset.name!.includes(q) || li.dataset.sectorText!.includes(q);
      const okType = key === 'type' ? li.dataset.type === value : !types.length || types.includes(li.dataset.type!);
      const okSector = key === 'sector' ? li.dataset.sector === value : !sectors.length || sectors.includes(li.dataset.sector!);
      return okQ && okType && okSector;
    };
    for (const dd of dds) {
      const key = dd.dataset.key as 'type' | 'sector';
      for (const input of dd.querySelectorAll<HTMLInputElement>('input[type=checkbox]')) {
        const label = input.closest('label')!;
        const n = items.filter((li) => matches(li, key, input.value)).length;
        const num = label.querySelector<HTMLElement>('span:last-child');
        if (num) num.textContent = String(n);
        label.style.display = n === 0 && !input.checked ? 'none' : '';
      }
    }
    for (const dd of dds) {
      const n = selected(dd).length;
      const badge = dd.querySelector<HTMLElement>('.dd-badge')!;
      badge.textContent = String(n);
      badge.classList.toggle('hidden', n === 0);
    }
  }

  function closeAll(except?: HTMLElement) {
    for (const dd of dds) {
      if (dd === except) continue;
      dd.querySelector('.dd-menu')!.classList.add('hidden');
      dd.querySelector('.dd-trigger')!.setAttribute('aria-expanded', 'false');
    }
  }

  for (const dd of dds) {
    const trigger = dd.querySelector<HTMLButtonElement>('.dd-trigger')!;
    const menu = dd.querySelector<HTMLElement>('.dd-menu')!;
    trigger.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      trigger.setAttribute('aria-expanded', String(open));
      closeAll(dd);
    });
    dd.querySelectorAll('input').forEach((i) => i.addEventListener('change', apply));
    dd.querySelector('.dd-clear')!.addEventListener('click', () => {
      dd.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = false));
      apply();
    });
    dd.querySelector('.dd-close')!.addEventListener('click', () => {
      closeAll();
      trigger.focus();
    });
  }

  search.addEventListener('input', apply);
  document.getElementById('empty-clear')!.addEventListener('click', () => {
    search.value = '';
    root.querySelectorAll<HTMLInputElement>('input[type=checkbox]').forEach((i) => (i.checked = false));
    apply();
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.dd')) closeAll();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
  apply();
</script>

<style>
  /* Project Row, from Figma node 8:238. Text colours go through registered custom
     properties so the hover gradient fades in over 300ms like the smart animate. */
  .prow { transition: padding 300ms ease; }
  .t {
    background-image: linear-gradient(90deg, var(--c1), var(--c2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: --c1 300ms ease, --c2 300ms ease, padding 300ms ease;
  }
  .t-num { --c1: #6a6862; --c2: #6a6862; }
  .t-name { --c1: #0b0b0d; --c2: #0b0b0d; }
  .t-sector { --c1: #4d4c48; --c2: #4d4c48; }
  :global(.row-arrow) { stroke-width: 1.5; stroke: url(#row-arrow-grad); }


  /* Arrows (plain :hover so they also respond on touch devices, and on keyboard focus). */
  .arr-m-default,
  .arr-m-hover { transition: opacity 300ms ease; }
  .arr-m-hover { opacity: 0; }
  .arr-d {
    flex: none;
    width: 0;
    margin-left: -24px;
    overflow: hidden;
    opacity: 0;
    transition: margin 300ms ease, width 300ms ease, opacity 300ms ease;
  }
  .prow:hover .arr-d,
  .prow:focus-visible .arr-d { width: 32px; margin-left: 0; opacity: 1; }

  /* Hover (all sizes, mobile matches tablet): gradient text, name indents 8px.
     Desktop/tablet also reveal the arrow; mobile keeps its arrow as is. */
  .prow:hover .t,
  .prow:focus-visible .t,
  .prow:active .t { --c1: #1f45e0; --c2: #2f5bff; }
  .prow:hover .t-name,
  .prow:focus-visible .t-name,
  .prow:active .t-name { padding-inline: 8px; }

  @media (prefers-reduced-motion: reduce) {
    .prow, .t { transition: none; }
  }
  @media (forced-colors: active) {
    .t { background: none; color: CanvasText; }
  }
</style>
