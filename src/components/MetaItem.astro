---
interface Props { label: string; value: string }
const { label, value } = Astro.props;
---

<div class="flex flex-col gap-2 pt-4">
  <dt class="text-[12px] font-semibold uppercase tracking-[0.08em] text-ink-2">{label}</dt>
  <dd class="text-[16px] font-semibold leading-[1.4] md:text-[18px]">{value}</dd>
</div>
