---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import { url } from '../lib/data';
---

<Base title="Page not found · Rohaizad Johari" description="This page could not be found.">
  <Nav />
  <main class="dotted-grid pt-[73px] md:pt-[89px]">
    <div data-hero class="mx-auto flex min-h-[70dvh] max-w-[1440px] flex-col justify-center gap-8 px-5 py-20 md:gap-10 md:px-20">
      <p class="flex items-center gap-2 text-[12px] font-semibold uppercase tracking-[0.08em] text-accent md:text-[13px]">
        <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
        404
      </p>
      <h1 class="grad-charcoal w-fit font-display text-[56px] font-extrabold leading-[1.08] tracking-[-0.035em] md:text-[100px]">Page not found.</h1>
      <div>
        <Button label="Back to Home" icon="arrow-right" href={url('/')} />
      </div>
    </div>
  </main>
  <Footer />
</Base>
